<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <dv style="background: orange; color: black; padding: 20px; display: flex; flex-direction: column;">
        <h1>All articles</h1>
        <% for(let art of allArticles ) {%>
            <div>
                <h2><%= art.title %></h2>
                <p><%= art.body %></p>
            </div>
            <hr />
            <br />
        <%  } %>
    </dv>
</body>
</html>